{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidewatch",
  "version": "0.1.2",
  "identifier": "dev.tidewatch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "观澜 Tidewatch", "width": 1360, "height": 860, "minWidth": 1080, "minHeight": 680, "dragDropEnabled": false, "decorations": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["SimpChinese", "English"], "installMode": "currentUser", "installerIcon": "icons/icon.ico", "installerHooks": "installer-hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0Q0Y0ODY3RENBMUI0REUKUldUZXRLSGNaMGpQaEhZOWRVRTV6eStuSjNZRDBMSHpSQlhMMDROVjlNekx0MmdRYWVONUdCNnUK",
      "endpoints": ["https://github.com/yoob52/Tidewatch/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
